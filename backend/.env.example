DATABASE_URL=mysql+pymysql://USER:YOUR_PASSWORD@localhost:3306/mailmate
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an Authorized redirect URI in Google Cloud (http only allowed for localhost)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=CHANGE_ME_RUN_Fernet.generate_key()
FRONTEND_URL=http://localhost:3000
# Set to false only if serving over plain http on a non-localhost address
COOKIE_SECURE=true
# First account can always sign up; set true to allow more
ALLOW_SIGNUP=false
